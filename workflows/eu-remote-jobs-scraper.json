    {
      "id": "e1000001-0000-4000-8000-000000000004",
      "name": "Resolve Tags",
      "parameters": {
        "jsCode": "return $input.all().map(i => ({\n  json: {\n    category: i.json.category,\n    url: `https://euremotejobs.com/wp-json/wp/v2/job_listing_tag?search=${encodeURIComponent(i.json.category)}&per_page=5`\n  }\n}));"
      },
      "position": [
        672,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "e1000001-0000-4000-8000-000000000005",
      "name": "Fetch Tags",
      "onError": "continueRegularOutput",
      "parameters": {
        "options": {
          "batching": {
            "batch": {
              "batchInterval": 1000,
              "batchSize": 1
            }
          },
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "url": "={{ $json.url }}"
      },
      "position": [
        896,
        400
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4
    },
    {
      "id": "e1000001-0000-4000-8000-000000000006",
      "name": "Build Queries",
      "parameters": {
        "jsCode": "const seen = new Set();\nconst queries = [];\nconst resolveItems = $('Resolve Tags').all();\n\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i];\n  const category = resolveItems[i]?.json?.category || '';\n\n  let tags;\n  try {\n    tags = JSON.parse(item.json.data || '[]');\n  } catch {\n    continue;\n  }\n\n  if (!Array.isArray(tags) || tags.length === 0) continue;\n\n  const tag = tags.find(t =>\n    t.name.toLowerCase() === category.toLowerCase()\n  ) || tags[0];\n\n  if (!seen.has(tag.id)) {\n    seen.add(tag.id);\n    queries.push({ json: { tagId: tag.id, tagName: tag.name, category } });\n  }\n}\n\nreturn queries;"
      },
      "position": [
        1120,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "e1000001-0000-4000-8000-000000000007",
      "name": "Fetch Jobs",
      "onError": "continueErrorOutput",
      "parameters": {
        "options": {
          "batching": {
            "batch": {
              "batchInterval": 2000,
              "batchSize": 1
            }
          },
          "timeout": 30000
        },
        "url": "=https://euremotejobs.com/wp-json/wp/v2/job-listings?per_page=100&page=1&_embed&job_listing_tag={{ $json.tagId }}&orderby=date&order=desc"
      },
      "position": [
        1344,
        400
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4
    },
    {
      "id": "e1000001-0000-4000-8000-000000000008",
      "name": "Parse & Dedup",
      "parameters": {
        "jsCode": "const source = 'euremotejobs';\nconst seen = new Set();\nconst jobs = [];\n\n// Build tagId -> category map from Build Queries\nconst queryItems = $('Build Queries').all();\nconst tagToCategory = {};\nfor (const q of queryItems) {\n  tagToCategory[q.json.tagId] = q.json.category;\n}\n\nfor (const item of $input.all()) {\n  const wp = item.json;\n  if (!wp.link || seen.has(wp.link)) continue;\n  seen.add(wp.link);\n\n  const terms = wp._embedded?.['wp:term'] || [];\n  const allTerms = terms.flat();\n  const regions = allTerms.filter(t => t.taxonomy === 'job_listing_region');\n  const location = regions.map(r => r.name).join(', ') || null;\n\n  // Find category by matching WP tags to Build Queries tagId map\n  const wpTags = allTerms.filter(t => t.taxonomy === 'job_listing_tag');\n  const category = wpTags.map(t => tagToCategory[t.id]).find(c => c) || '';\n\n  jobs.push({\n    title: wp.title?.rendered || '',\n    company: wp.meta?._company_name || null,\n    url: wp.link,\n    description: wp.content?.rendered || '',\n    source,\n    salary: null,\n    location,\n    remote: true,\n    publishedAt: wp.date || null,\n    rawData: wp,\n    category,\n  });\n}\n\nreturn [{ json: { body: jobs, count: jobs.length, source } }];"
      },
      "position": [
        1568,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
