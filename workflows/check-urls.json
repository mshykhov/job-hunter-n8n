    {
      "id": "e1000001-0000-4000-8000-000000000003",
      "name": "Parse Response",
      "parameters": {
        "jsCode": "const json = $input.first().json;\nlet existingUrls;\n\nif (Array.isArray(json)) {\n  existingUrls = json;\n} else if (typeof json.data === 'string') {\n  try { existingUrls = JSON.parse(json.data); } catch (e) { existingUrls = []; }\n} else {\n  existingUrls = [];\n}\n\nif (!Array.isArray(existingUrls)) existingUrls = [];\nreturn [{json: { existingUrls }}];"
      },
      "position": [
        560,
        340
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "e1000001-0000-4000-8000-000000000010",
      "name": "Format Error",
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst source = $('Trigger').first().json.source || 'unknown';\nlet statusCode = 'N/A';\nlet code = 'UNKNOWN';\nlet message = 'Unexpected error';\n\nif (item.statusCode) statusCode = String(item.statusCode);\nif (item.body?.code) code = item.body.code;\nif (item.body?.message) message = item.body.message;\n\nconst raw = item.error?.message || '';\nif (raw && code === 'UNKNOWN') {\n  const statusMatch = raw.match(/^(\\d{3})/);\n  if (statusMatch) statusCode = statusMatch[1];\n  const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    try {\n      const parsed = JSON.parse(jsonMatch[0].replace(/\\\\\"/g, '\"'));\n      code = parsed.code || code;\n      message = parsed.message || message;\n    } catch (e) { message = raw; }\n  } else { message = raw; }\n}\n\nreturn [{json: {\n  level: 'error',\n  message: `POST /jobs/check-urls: HTTP ${statusCode} [${code}] \\u2014 ${message}`,\n  source\n}}];"
      },
      "position": [
        560,
        540
      ],
