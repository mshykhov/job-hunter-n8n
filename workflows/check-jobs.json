  "name": "Check Jobs",
  "nodes": [
    {
      "id": "e1000001-0000-4000-8000-000000000099",
      "name": "Sticky Note",
      "parameters": {
        "content": "## Check Jobs\nShared sub-workflow. Checks which job URLs are new, updated, or unchanged.\n\n**Input:** `{ jobs: JSON string of object array [{url, title, company, salary, location, publishedAt}], source: string }`\n**Output:** `{ newUrls: string[], updatedUrls: string[], unchangedUrls: string[] }`",
        "height": 160,
        "width": 720
      },
      "position": [
        -60,
        120
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "e1000001-0000-4000-8000-000000000001",
      "name": "Trigger",
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "jobs",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            }
          ]
        }
      },
      "position": [
        0,
        340
      ],
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1
    },
    {
      "id": "e1000001-0000-4000-8000-000000000002",
      "name": "POST check-jobs",
      "onError": "continueErrorOutput",
      "parameters": {
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.token ? 'Bearer ' + $json.token : '' }}"
            }
          ]
        },
        "jsonBody": "={{ $('Trigger').first().json.jobs }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "url": "={{ $env.JOB_HUNTER_API_URL + '/jobs/check' }}"
      },
      "position": [
        280,
        340
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4
    },
    {
      "id": "e1000001-0000-4000-8000-000000000003",
      "name": "Parse Response",
      "parameters": {
        "jsCode": "const json = $input.first().json;\nconst newUrls = json.newUrls || [];\nconst updatedUrls = json.updatedUrls || [];\nconst unchangedUrls = json.unchangedUrls || [];\nreturn [{json: { newUrls, updatedUrls, unchangedUrls }}];"
      },
      "position": [
        560,
        340
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "e1000001-0000-4000-8000-000000000010",
      "name": "Format Error",
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst source = $('Trigger').first().json.source || 'unknown';\nlet statusCode = 'N/A';\nlet code = 'UNKNOWN';\nlet message = 'Unexpected error';\n\nif (item.statusCode) statusCode = String(item.statusCode);\nif (item.body?.code) code = item.body.code;\nif (item.body?.message) message = item.body.message;\n\nconst raw = item.error?.message || '';\nif (raw && code === 'UNKNOWN') {\n  const statusMatch = raw.match(/^(\\d{3})/);\n  if (statusMatch) statusCode = statusMatch[1];\n  const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    try {\n      const parsed = JSON.parse(jsonMatch[0].replace(/\\\\\"/g, '\"'));\n      code = parsed.code || code;\n      message = parsed.message || message;\n    } catch (e) { message = raw; }\n  } else { message = raw; }\n}\n\nreturn [{json: {\n  level: 'error',\n  message: `POST /jobs/check: HTTP ${statusCode} [${code}] \\u2014 ${message}`,\n  source\n}}];"
      },
      "position": [
        560,
        540
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
