  "id": "b2hckmdbVWlAt5zH",
  "name": "Telegram Notify",
  "nodes": [
    {
      "id": "b1000001-0000-4000-8000-000000000001",
      "name": "Trigger",
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "level",
              "type": "string"
            },
            {
              "name": "message",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            }
          ]
        }
      },
      "position": [
        0,
