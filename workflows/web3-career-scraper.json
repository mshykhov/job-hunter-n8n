              "batchSize": 1
            }
          },
          "proxy": "={{ $('Get Proxy').first().json.proxyUrl }}",
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "sendHeaders": true,
        "url": "={{ $json.url }}"
      },
