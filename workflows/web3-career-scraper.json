    {
      "id": "c3000001-0000-4000-8000-000000000006",
      "name": "Parse Jobs",
      "parameters": {
        "jsCode": "const source = $('Set Source').first().json.source;\nconst criteriaItems = $('Build Page URLs').all();\nconst inputItems = $input.all();\nconst allJobs = [];\n\nfor (let i = 0; i < inputItems.length; i++) {\n  const inputItem = inputItems[i];\n  const category = criteriaItems[i]?.json?.category || '';\n  const html = inputItem.json.data;\n  if (!html || typeof html !== 'string') continue;\n\n  const jsonLdBlocks = [];\n  const jsonLdRegex = /<script type=\"application\\/ld\\+json\">([\\s\\S]*?)<\\/script>/g;\n  let m;\n  while ((m = jsonLdRegex.exec(html)) !== null) {\n    try {\n      const parsed = JSON.parse(m[1]);\n      const items = Array.isArray(parsed) ? parsed : [parsed];\n      for (const item of items) {\n        if (item['@type'] === 'JobPosting') jsonLdBlocks.push(item);\n      }\n    } catch {}\n  }\n\n  const urlRegex = /href=\"\\/([\\w][\\w.-]*(?:-[\\w.-]+)*\\/(\\d+))\"/g;\n  const urlMap = new Map();\n  let um;\n  while ((um = urlRegex.exec(html)) !== null) {\n    const path = '/' + um[1];\n    const id = um[2];\n    if (!urlMap.has(id)) urlMap.set(id, path);\n  }\n  const urlList = [...urlMap.values()];\n\n  for (let j = 0; j < jsonLdBlocks.length; j++) {\n    const p = jsonLdBlocks[j];\n    const jobUrl = j < urlList.length\n      ? 'https://web3.career' + urlList[j]\n      : null;\n    if (!jobUrl) continue;\n\n    const sal = p.baseSalary?.value;\n    const salaryStr = sal\n      ? `${sal.minValue}-${sal.maxValue} ${p.baseSalary?.currency || 'USD'}/${sal.unitText || 'YEAR'}`\n      : null;\n\n    allJobs.push({\n      json: {\n        title: p.title || '',\n        company: p.hiringOrganization?.name || null,\n        url: jobUrl,\n        description: p.description || '',\n        source,\n        salary: salaryStr,\n        location: p.applicantLocationRequirements?.name || null,\n        remote: p.jobLocationType === 'TELECOMMUTE',\n        publishedAt: p.datePosted || null,\n        rawData: p,\n        category,\n      }\n    });\n  }\n}\n\nreturn allJobs;"
      },
      "position": [
        1344,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "c3000001-0000-4000-8000-000000000007",
      "name": "Prepare Ingest",
      "parameters": {
        "jsCode": "const source = $('Set Source').first().json.source;\nconst seen = new Set();\nconst jobs = $input.all()\n  .map(i => i.json)\n  .filter(j => {\n    if (!j.url || seen.has(j.url)) return false;\n    seen.add(j.url);\n    return true;\n  });\n\nreturn [{json: {body: jobs, count: jobs.length, source}}];"
      },
